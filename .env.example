# Application Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgres://academia_admin:secret_password@localhost:5432/academia_auth_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=academia_admin
DB_PASSWORD=secret_password
DB_NAME=academia_auth_db
DB_SSL=false

# Authentication Secrets & Expiry
JWT_SECRET=super_secret_jwt_hmac_sha256_key_at_least_32_chars_long
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=super_secret_refresh_key_at_least_32_chars_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Institution Domain Restrictions for Faculty Verification
ALLOWED_FACULTY_DOMAINS=academia.edu,university.ac.in,faculty.institution.org

# Password Reset Token Expiry (in milliseconds or minutes)
RESET_TOKEN_EXPIRY_MINUTES=15

# Event Bus / Message Broker (e.g. RabbitMQ / Kafka stub for Event-Driven Microservices)
EVENT_BUS_TYPE=mock
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092
